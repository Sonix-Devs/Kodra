{
  // Kodra sample settings — add unchanged at Stage 3 gate; verify Settings UI ↔ settings.json round-trip,
  // including keys for extensions that are not installed (no crash, no strip).
  "editor.fontSize": 14,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "workbench.colorTheme": "Dark 2026",
  "workbench.iconTheme": "material-icon-theme",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.cursorBlinking": true,
  // Built-in Git (keep, verify graph/timeline)
  "git.enabled": true,
  "git.autofetch": false,
  "scm.graph.pageSize": 100,
  "scm.graph.badges": true,
  // Requested bundled extensions (Stage 5) — must survive even when not installed
  "prettier.enable": true,
  "prettier.requireConfig": false,
  "material-icon-theme.hidesExplorerArrows": false,
  "liveServer.settings.donotShowInfoMsg": true,
  "python.defaultInterpreterPath": "/data/data/dev.unalivin.kodra/files/usr/bin/python3",
  // Discord (Stage 5 separate gate) — keep keys even if extension not bundled
  "discord.enabled": true,
  "discord.detailsEditing": "In Kodra",
  // Telemetry off — must stay false
  "telemetry.telemetryLevel": "off",
  // Update checks off — GitHub Releases is the channel
  "update.mode": "none"
}
